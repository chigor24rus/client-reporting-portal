{
  "tests": [
    {
      "name": "Get master clients returns 200",
      "method": "GET",
      "path": "/?user_id=5",
      "expectedStatus": 200
    },
    {
      "name": "Patch without id returns 405",
      "method": "PATCH",
      "path": "/",
      "body": {},
      "expectedStatus": 405
    },
    {
      "name": "Lock without id returns 405",
      "method": "POST",
      "path": "/?action=lock",
      "body": {"user_id": "1"},
      "expectedStatus": 405
    },
    {
      "name": "Unknown action returns 400",
      "method": "POST",
      "path": "/?id=999&action=foo",
      "body": {"user_id": "1"},
      "expectedStatus": 400
    },
    {
      "name": "Pending count returns number",
      "method": "GET",
      "path": "/?pending_count=true",
      "expectedStatus": 200
    },
    {
      "name": "Daily stats returns array",
      "method": "GET",
      "path": "/?daily_stats=true",
      "expectedStatus": 200
    }
  ]
}